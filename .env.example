# StadiumOps AI Command Center — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real API keys to source control.

# -----------------------------------------------------------------
# Google Gemini AI Configuration (required for Phase 4 AI features)
# -----------------------------------------------------------------

# Your Gemini API key from Google AI Studio (https://aistudio.google.com)
VITE_GEMINI_API_KEY=

# Gemini model to use (e.g., gemini-2.0-flash, gemini-1.5-pro)
VITE_GEMINI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------
# AI Request Tuning (optional — defaults are pre-configured)
# -----------------------------------------------------------------

# Maximum tokens in AI response output (default: 1024)
VITE_AI_MAX_TOKENS=1024

# Request timeout in milliseconds (default: 15000)
VITE_AI_TIMEOUT=15000

# Number of retry attempts for transient failures (default: 3)
VITE_AI_RETRY_COUNT=3
